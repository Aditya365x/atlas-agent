# --- Model (any LiteLLM model string). Pick one provider and add its key. ---
MODEL_MAIN=gemini/gemini-2.5-flash
# MODEL_PLANNER=gemini/gemini-2.5-flash-lite
# MODEL_FALLBACKS=["deepseek/deepseek-chat","groq/llama-3.3-70b-versatile"]
GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Set to fake to run everything offline with a deterministic model (no keys needed)
LLM_MODE=live

# --- Optional quality upgrades ---
# TAVILY_API_KEY=            # better web search (DuckDuckGo is used without it)
# EMBEDDING_MODEL=gemini/text-embedding-004

# --- Security: change both for anything public ---
JWT_SECRET=change-me-in-production-please-32b+
SANDBOX_TOKEN=dev-sandbox-token

# --- Observability (optional) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
